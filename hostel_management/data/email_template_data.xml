<?xml version="1.0" encoding="UTF-8"?>
<odoo><data>
    <record id="email_template_data" model="mail.template">
        <field name="name">Invoice: posted!</field>
        <field name="model_id"
               ref="account.model_account_move"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="subject">your invoice ref-{{ object.display_name }} as been posted</field>
        <field name="use_default_to" eval="False"/>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="body_html" type="html">
            <p>this email for the confirmation about your invoice has
                been posted!..</p>
        </field>
    </record>
</data></odoo>