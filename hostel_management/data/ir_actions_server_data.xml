<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="action_create_portal_access" model="ir.actions.server">
            <field name="name">Create portal user</field>
           <field name="model_id" ref="hostel_management.model_hostel_student"/>
           <field name="binding_model_id" ref="hostel_management.model_hostel_student"/>
           <field name="binding_view_types">list</field>
           <field name="state">code</field>
           <field name="code">
               action = records.grand_access()
           </field>
        </record>
        <!-- Autmation action for create portal access-->
        <record id="automation_action_create_portal_access"
                model="base.automation">
            <field name="name">automation create portal access</field>
            <field name="model_id" ref="hostel_management.model_hostel_student"/>
             <field name="trigger">on_create</field>
            <field name="action_server_ids" eval="[Command.link(ref('action_create_portal_access'))]"/>
        </record>

    </data>
</odoo>