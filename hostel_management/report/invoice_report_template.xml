<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="report_invoice_document">
             <t t-call="web.html_container">
                  <t t-foreach="docs" t-as="o">
                      <t t-call="web.external_layout">
                          <div class="page">
                              <h2>Invoice: <t t-out="o.name"/></h2>
                              <h2>Customer: <t t-out="o.partner_id.name"/></h2>
                              <p> Invoice Date: <t t-out="o.invoice_date"/> </p>
                              <h3>Order Lines:</h3>
                              <table class="table table-sm" >
                               <thead>
                                   <tr>
                                       <th>Product</th>
                                       <th>Quantity</th>
                                       <th>Price</th>
                                       <th>Amount</th>
                                   </tr>
                               </thead>
                               <tboady>
                                  <tr t-foreach="o.invoice_line_ids" t-as="line">
                                        <td><t t-out="line.product_id.name"/></td>
                                        <td><t t-out="line.quantity"/></td>
                                        <td><t t-out="line.price_unit"/></td>
                                      <td><t t-out="line.price_subtotal"/></td>
                                   </tr>
                                   <tr class="text-primary">
                                       <td> </td>
                                       <td> </td>
                                          <td>Total</td>
                                          <td><t t-out="o.amount_residual"/></td>
                                      </tr>
                               </tboady>
                              </table>
                          </div>
                      </t>
                  </t>
             </t>
        </template>
    </data>
</odoo>