<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hostel_facility_action" model="ir.actions.act_window">
        <field name="name">Hostel Facility</field>
        <field name="res_model">hostel.facility</field>
        <field name="view_mode">list,kanban</field>
    </record>
    <record id="hostel_facility_view_list" model="ir.ui.view">
        <field name="name">hostel.facility.view.list</field>
        <field name="model">hostel.facility</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="facility_name"/>
                <field name="monthly_charge"/>
                <field name="company_id" options="{'no_create': True}"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>
</odoo>