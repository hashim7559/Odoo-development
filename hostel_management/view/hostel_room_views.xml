<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hostel_room_action" model="ir.actions.act_window">
        <field name="name">Room</field>
        <field name="res_model">hostel.room</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="context">{'search_default_available': True}</field>
    </record>


    <record id="hostel_room_view_list" model="ir.ui.view">
        <field name="name">hostel.room.view.list</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="bed_count"/>
                <field name="base_rent"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="facilities_id"/>
                <field name="room_status" widget="badge"
                       decoration-success="room_status == 'empty'"
                       decoration-danger="room_status == 'full'"
                       decoration-warning="room_status == 'partial'"/>
            </list>
        </field>
    </record>
    <record id="hostel_room_view_form" model="ir.ui.view">
        <field name="name">hostel.room.view.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="monthly_invoice" type="object"
                            string="Monthly invoice"
                            invisible="not student_ids"/>
                    <field name="room_status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="In cleaning"
                            bg_color="text-bg-danger"
                            invisible="ribbon"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="room_invoices" type="object"
                                string="invoices"/>
                    </div>
                    <h1><field name="room_number" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="room_type"/>
                            <field name="bed_count"/>
                            <field name="base_rent"/>
                            <field name="total_rent"/>
                            <field name="pending_amount"/>
                        </group>
                        <group>
                            <field name="facilities_id"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   options="{'no_create': True}"/>
                            <field name="currency_id"/>
                            <field name="product_id"/>

                        </group>
                    </group>
                        <field name="student_ids">
                            <list>
                                <field name="student_id"/>
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </list>
                        </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hostel_room_view_kanban" model="ir.ui.view">
        <field name="name">hostel.room.view.kanban</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" >
                        <field name="room_number"
                               class="fw-bold fs-3 text-muted"/>
                        <field name="room_type" widget="badge" />
                        <field name="base_rent"/>
                        <footer>
                            <field name="student_ids" widget="one2many"
                                   class="mt-auto"/>
                            <div class="ms-auto">
                                <span>Bed's: </span>
                                <field name="bed_count" class="text-primary fw-bold"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>




    <record id="hostel_room_view_search" model="ir.ui.view">
        <field name="name">hostel.room.view.search</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="bed_count"/>
                <field name="base_rent"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="facilities_id"/>
                <field name="room_status"/>
                <filter name="with facility"
                        domain="[('facilities_id','!=',False)]"/>
                <filter name="available"
                        domain="[('room_status','in',['empty','partial'])]"/>
                <filter name="By bed count"
                        context="{'group_by':'bed_count'}"/>
                <filter name="By room type"
                        context="{'group_by':'room_type'}"/>
            </search>
        </field>
    </record>
</odoo>