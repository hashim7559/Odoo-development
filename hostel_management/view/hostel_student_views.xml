<?xml version="1.0"  ?>
<odoo>
    <record id="hostel_student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">hostel.student</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="hostel_student_view_list" model="ir.ui.view">
        <field name="name">hostel.student.view.list</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="hostel_student_view_form" model="ir.ui.view">
        <field name="name">hostel.student.view.form</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="allot_room" type="object"
                            string="Allot room" invisible="joining"/>
                </header>
                <sheet>
                    <field name="image_1920"
                                   class="oe_avatar"
                                   widget="contact_image"
                                   options="{
                                        'preview_image': 'avatar_128',
                                        'size': [130,130],
                                        'img_class': 'border rounded h-100 object-fit-contain'}"/>
                    <h1><field name="student_id"/></h1>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="room_id"/>

                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="company_id"/>
                            <field name="joining"/>
                            <field name="partner_id" invisible="not id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>