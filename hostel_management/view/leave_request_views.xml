<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="leave_request_view_action" model="ir.actions.act_window">
        <field name="name">Leave Request</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="leave_request_view_list" model="ir.ui.view">
        <field name="name">leave.request.view.list</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="status" widget="badge"
                        decoration-success="status in ('approved')"
                        decoration-danger="status == 'rejected'"
                        decoration-warning="status == 'cancelled'"/>
                <field name="leave_type" widget="Many2Many_tags"/>
            </list>
        </field>
    </record>
    <record id="leave_request_view_form" model="ir.ui.view">
        <field name="name">leave.request.view.form</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <form >
                <header>
                    <button name="approve" type="object" string="Approve"
                            invisible="status == 'approved'"/>
                    <button name="reject" type="object" string="Reject"
                            invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"
                                   readonly="status != 'new'"
                                   options="{'no_create': True}"/>
                            <field name="leave_type"
                                   readonly="status != 'new'"/>
                        </group>
                        <group>
                            <field name="from_date"
                                   widget="daterange"
                                   options="{'end_date_field': 'to_date',
                                             'always_range': True,
                                             'min_date': 'today'}"
                                   readonly="status != 'new'"/>
                            <field name="to_date"
                                   readonly="status != 'new'"
                                   invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>