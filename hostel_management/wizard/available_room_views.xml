<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="available_room_view_action"
            model="ir.actions.act_window">
        <field name="name">available rooms</field>
        <field name="res_model">wizard.available.room</field>
        <field name="view_mode">form</field>
    </record>
    <record id="available_room_view_form" model="ir.ui.view">
        <field name="name">available.room.view.form</field>
        <field name="model">wizard.available.room</field>
        <field name="arch" type="xml">
            <form string="list room available">
                <h1>
                    <field name="room_id" options="{'no_create': True}"/>
                </h1>
                <group>
                    <group>
                        <field name="student_id" options="{'no_create': True}"/>
                        <field name="room_type"/>
                        <field name="bed_count"/>
                    </group>
                    <group>
                        <field name="joining" options="{'min_date': today}"/>
                        <field name="total_rent"/>
                        <field name="currency_id"/>
                        <field name="room_status" widget="badge"
                               decoration-success="room_status == 'empty'"
                               decoration-danger="room_status == 'full'"
                               decoration-warning="room_status == 'partial'"/>
                    </group>
                </group>
                <footer>
                    <button name="confirm" type="object" string="Confirm"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>